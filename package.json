{
  "name": "invoice-app",
  "version": "1.1.8",
  "description": "برنامج فواتير بسيط يعمل بدون إنترنت ويحفظ PDF",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test.js",
    "e2e": "node scripts/e2e.js",
    "sample": "node scripts/sample-pdf.js",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.invoice.app",
    "productName": "Invoices",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Rechnungen-V${version}.${ext}"
    },
    "copyright": "© Rami Horani, HoraniQ IT-Lösungen"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.48.0"
  },
  "license": "MIT",
  "author": {
    "name": "Rami Horani",
    "email": "Rami@horaniq.at",
    "url": "https://horaniq.at"
  },
  "homepage": "https://horaniq.at"
}
